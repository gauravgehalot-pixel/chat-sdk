{
  "name": "@opsrabbit/chat",
  "version": "0.4.0",
  "description": "TypeScript SDK and framework-neutral web component for integrating OpsRabbit chat.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": ["./dist/widget.js"],
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist",
    "docs",
    "examples",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE",
    "NOTICE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./widget": {
      "types": "./dist/widget.d.ts",
      "import": "./dist/widget.js"
    },
    "./react-native": {
      "types": "./dist/react-native.d.ts",
      "import": "./dist/react-native.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --maxWorkers=1 --no-file-parallelism",
    "test:coverage": "vitest run --coverage --maxWorkers=1 --no-file-parallelism",
    "pack:verify": "node scripts/verify-package.mjs",
    "quality": "npm run lint && npm run check && npm run test:coverage && npm run build && npm run pack:verify",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.10.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.0.1",
    "happy-dom": "^20.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ops-Rabbit/chat-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/Ops-Rabbit/chat-sdk/issues"
  },
  "homepage": "https://github.com/Ops-Rabbit/chat-sdk#readme"
}
